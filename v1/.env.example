APP_NAME="Manan V1"
ENV=development
HOST=0.0.0.0
PORT=8001

GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

DATA_DIR=./data
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manan_ai_v1
CHROMA_PERSIST_DIRECTORY=./data/chroma_v1
UPLOAD_DIR=./data/uploads_v1
CHROMA_COLLECTION=documents_v1

MAX_UPLOAD_SIZE_MB=50
TOTAL_STORAGE_LIMIT_MB=500
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TESSERACT_CMD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
