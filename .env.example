# ==============================================================================
# Manan-AI Environment Configuration
# ==============================================================================

# Core Application Settings
APP_NAME="Manan-AI"
ENV=production
HOST=0.0.0.0
PORT=8000

# ==============================================================================
# PostgreSQL Database (with pgvector extension)
# ==============================================================================
# Note for Docker Local Testing:
# - Inside Docker backend container: connect to service hostname 'postgres:5432'
# - From host machine (e.g. psql / DBeaver): connect to host port 5433 ('localhost:5433')
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=manan_ai
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/manan_ai

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Generate a secure 32+ character key with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_EXPIRY_DAYS=30

# ==============================================================================
# Google Gemini & OAuth Configuration
# ==============================================================================
GOOGLE_API_KEY=your_google_gemini_api_key_here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Frontend Base URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# LLM Provider Configuration
# Supported providers: "gemini" | "ollama"
# Supported production models: "gemini-3.6-flash" | "gpt-oss:120b"
# ==============================================================================
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

# Ollama Cloud API Configuration (https://ollama.com)
# The backend authenticates via OLLAMA_API_KEY over HTTPS
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

# ==============================================================================
# Cloudinary Document Storage
# Permanent cloud storage provider for uploaded study materials and documents.
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=manan-ai
CLOUDINARY_UPLOAD_PRESET=manan-ai

# ==============================================================================
# Embeddings & Vector Search (PostgreSQL pgvector)
# ==============================================================================
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ==============================================================================
# Document Processing Quotas & Limits
# ==============================================================================
MAX_UPLOAD_SIZE_MB=50
TOTAL_STORAGE_LIMIT_MB=500
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ==============================================================================
# Hugging Face Hosted Inference OCR Configuration
# ==============================================================================
# Qwen2.5-VL via Hugging Face Hosted Inference API
HF_API_TOKEN=
HF_OCR_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# ==============================================================================
# CORS Configuration (comma-separated allowed origins)
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# Frontend API Endpoint (Used by Vite client)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8000
